{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@leksis/web"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@leksis/api"],
      "port": 8080
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LEKSIS_API=http://127.0.0.1:8080",
        "npm",
        "run",
        "dev",
        "-w",
        "@leksis/web"
      ],
      "port": 5173
    }
  ]
}
